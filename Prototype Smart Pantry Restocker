const pantry = [
  { sku: "A10", name: "Tomatoes", qty: 4, expires: "2027-01-01", zone: "fridge" },
  { sku: "D43", name: "Pineapples", qty: 2, expires: "2020-01-01", zone: "general" }
];

const rawData = [
  "A10|Tomatoes|5|2027-01-01",
  "B21|Bananas|10|2027-01-01",
  "C32|Eggs|3|2027-01-01|fridge",
  "C32|Eggs|3|2027-01-01",
  "D43|Pineapples|0|2027-01-01",
  "E54|Peppers|-1|2027-01-01|fridge"
];

// 1. parseShipment: Parses raw strings, handles duplicates, defaults zone, and casts qty to a number
function parseShipment(rawData) {
  let parsedItems = [];
  let seenSkus = new Set();

  for (const row of rawData) {
    let parts = row.split("|");
    let sku = parts[0];
    let name = parts[1];
    let qty = Number(parts[2]);
    let expires = parts[3];
    let zone = parts[4] ? parts[4] : "general";

    if (!seenSkus.has(sku)) {
      seenSkus.add(sku);
      parsedItems.push({
        sku: sku,
        name: name,
        qty: qty,
        expires: expires,
        zone: zone
      });
    }
  }

  return parsedItems;
}

// 2 & 3. planRestock: Evaluates incoming shipment against pantry for "discard", "restock", or "donate"
function planRestock(pantry, shipment) {
  let actions = [];
  let pantrySkus = pantry.map(item => item.sku);

  for (const item of shipment) {
    let actionType = "";

    if (item.qty <= 0) {
      actionType = "discard";
    } else if (pantrySkus.includes(item.sku)) {
      actionType = "restock";
    } else {
      actionType = "donate";
    }

    actions.push({
      type: actionType,
      item: item
    });
  }

  return actions;
}

// 4. groupByZone: Groups actions into objects based on storage zones
function groupByZone(actions) {
  let grouped = {};

  for (const action of actions) {
    let zone = action.item.zone;

    if (!grouped[zone]) {
      grouped[zone] = [];
    }

    grouped[zone].push(action);
  }

  return grouped;
}

// 5. clonePantry: Returns a true deep copy of the pantry array and its objects
function clonePantry(pantry) {
  let clonedArray = [];

  for (const item of pantry) {
    clonedArray.push({
      sku: item.sku,
      name: item.name,
      qty: item.qty,
      expires: item.expires,
      zone: item.zone
    });
  }

  return clonedArray;
}

// Step 18: Wire all functions together using the test environment's variables and log it
console.log(groupByZone(planRestock(clonePantry(pantry), parseShipment(rawData))));
