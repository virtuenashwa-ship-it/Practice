def number_pattern(n):

    #check if the number is a integer or bool if it's not return phrase
    if not isinstance(n, int) or isinstance(n, bool):
        return 'Argument must be an integer value.'
    
    #check if the number is lower than 1 if it is return phrase
    if n < 1:
        return 'Argument must be an integer greater than 0.'

    pattern = []

    #loop through the list and adds string number to the end of pattern 
    for num in range(1, n + 1):
        pattern.append(str(num))

    return ' '.join(pattern)        
