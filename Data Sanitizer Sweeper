// Step 1: Check if entry contains the disallowed characters then replace them with a # or let them pass.
function sanitizeLog (entry, disallowedCharacters){
  let result = ''
  for (const char of entry){
     if (disallowedCharacters.includes(char)) {
      result += '#';
     } else {
      result += char;
     }
  }

  return result;
}

// Step 2: Check if log contains the disallowed characters then replace them with a # or let them pass.
function cleanLogs(logs, disallowedCharacters) {
  let totalCount = logs.length;
  let sanitizeCount = 0;
  let informationalCount = 0;
  
for (const log of logs) {
  if (log.includes('$')){
    return "Sanitizing stopped. Failure Reason: Fatal character occurred."
  }

  if (log.startsWith('/')) {
    informationalCount++;
  } else {
    sanitizeLog(log, disallowedCharacters)
    sanitizeCount++
  }
  }

  return `Total Entry Count: ${totalCount}. Sanitized Entry Count: ${sanitizeCount}. Informational Entry Count: ${informationalCount}. Finished sanitizing logs.`;
}

